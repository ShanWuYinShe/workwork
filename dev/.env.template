# dev-env Configuration Template
# Copy this file to .env and customize as needed

# Docker Compose Project Name
COMPOSE_PROJECT=service

# PostgreSQL Configuration
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app123
POSTGRES_PORT=5433

# Redis Configuration
REDIS_PORT=6379

# MinIO Configuration
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# Development Container Ports
DEV_PORT_1=3000
DEV_PORT_2=3001
DEV_PORT_3=8080

# IP Address Management (ipvlan_docker network)
# Reserved IPs that should not be auto-allocated
# Format: single IP, comma-separated IPs, or range start-end
IPVLAN_RESERVED=172.18.0.1-172.18.0.50