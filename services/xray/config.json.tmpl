{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "https+local://1.1.1.1/dns-query",
      "1.1.1.1",
      "localhost"
    ],
    "queryStrategy": "UseIP",
    "enableParallelQuery": true,
    "useSystemHosts": true
  },
  "inbounds": [
    {
      "tag": "xhttp-in",
      "listen": "/run/xray/xrxh.socket,0660",
      "protocol": "vless",
      "settings": {
        "clients": __XRAY_CLIENTS_JSON__,
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "/proxy/query",
          "mode": "packet-up"
        },
        "sockopt": {
          "trustedXForwardedFor": ["X-Real-IP"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    },
    {
      "tag": "reality-in",
      "listen": "::",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": __XRAY_REALITY_CLIENTS_JSON__,
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "__XRAY_REALITY_DEST__",
          "xver": 0,
          "serverNames": ["__XRAY_REALITY_SERVER_NAME__"],
          "privateKey": "__XRAY_PRIVATE_KEY__",
          "shortIds": __XRAY_SHORT_IDS_JSON__
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIP",
          "happyEyeballs": {
            "tryDelayMs": 1,
            "prioritizeIPv6": false,
            "interleave": 1,
            "maxConcurrentTry": 4
          },
          "tcpFastOpen": true,
          "tcpKeepAliveIdle": 45,
          "tcpKeepAliveInterval": 45,
          "tcpUserTimeout": 10000,
          "tcpCongestion": "bbr"
        }
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private",
          "0.0.0.0/8",
          "100.64.0.0/10",
          "127.0.0.0/8",
          "169.254.0.0/16",
          "::1/128",
          "fc00::/7",
          "fe80::/10"
        ],
        "outboundTag": "blocked"
      }
    ]
  }
}
