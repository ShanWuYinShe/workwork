{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "https+local://1.1.1.1/dns-query",
      "1.1.1.1",
      "localhost"
    ],
    "queryStrategy": "UseIP",
    "enableParallelQuery": true,
    "useSystemHosts": true
  },
  "inbounds": [
    {
      "tag": "xhttp-in",
      "listen": "/dev/shm/xrxh.socket,0666",
      "protocol": "vless",
      "settings": {
        "clients": __XRAY_CLIENTS_JSON__,
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "/proxy/query",
          "mode": "stream-up"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    },
    {
      "tag": "reality-in",
      "listen": "::",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": __XRAY_REALITY_CLIENTS_JSON__,
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "__XRAY_REALITY_DEST__",
          "xver": 0,
          "serverNames": ["__XRAY_REALITY_SERVER_NAME__"],
          "privateKey": "__XRAY_PRIVATE_KEY__",
          "shortIds": ["__XRAY_SHORT_IDS__"]
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIP",
          "tcpFastOpen": true,
          "tcpKeepAliveIdle": 45,
          "tcpKeepAliveInterval": 45,
          "tcpUserTimeout": 10000,
          "tcpcongestion": "bbr"
        }
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs"
  }
}
