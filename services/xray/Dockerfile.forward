# IPv4 直连发布容器: 宿主 0.0.0.0:443 → socat → xray_egress 网络内 xray:443。
#
# 为什么需要它: xray 容器同时连接 ipvlan 网络时,Docker(29.x 实测)会把
# ipvlan 网络选为默认网关网络(gwep4)——ipvlan 不支持端口映射,导致容器的
# 全部端口映射失效(与网络连接顺序无关)。xray 的 IPv6 必须走 ipvlan L3
# 直连(公网地址),因此 IPv4 入站只能由这个纯 bridge 转发容器发布。
# xray 本身不再声明 ports。
FROM alpine:${ALPINE_VERSION:-3.24.1}
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories \
    && apk add --no-cache socat
EXPOSE 443
# 非 root 运行:容器 netns 内 ip_unprivileged_port_start=0(同 xray 容器),
# 443 对非 root 开放,cap_drop:ALL 下无需任何特权即可监听。
USER nobody
# max-children=256: 限制 fork 模式的并发子进程数,超出后新连接被拒绝。
# 纯 TCP 转发器没有应用层鉴权,公网暴露在 443,无上限的 fork 会被连接
# 洪泛打满(每个连接一个子进程),导致容器资源耗尽。
CMD ["socat", "TCP-LISTEN:443,fork,reuseaddr,max-children=256", "TCP:xray:443"]
