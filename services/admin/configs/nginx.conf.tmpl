# uri= 记录 nginx 解码+规范化后的路径，供 fail2ban 匹配——$request 是客户端
# 原始请求行，/%61dmin/、/./admin/ 等变体在 location/auth 层与 /admin/ 等价
# （同样 401），但原始行不匹配旧 failregex，撞库计数被完全绕过。
log_format auth_log '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'upstream: $upstream_addr uri="$uri"';

include /etc/nginx/cloudflare-ips.conf;

server_tokens off;

tcp_nodelay on;

resolver 127.0.0.11 valid=30s;

# ── 速率限制 ──
# $binary_remote_addr 经 real_ip 模块解析(CF-Connecting-IP),按它限速即按真实
# 客户端 IP 限速。这是 fail2ban(只数 401)之外的第二道闸:持有有效凭证的滥用、
# 公开下载的 code 穷举不产生 401,fail2ban 看不见。
# 刻意不覆盖 /proxy/query(XHTTP packet-up 高频 POST 是代理数据面)。
# (media/music API 已拆分至独立站,其 per-IP 限流随站走。)
limit_req_zone $binary_remote_addr zone=admin_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=transfer_dl:10m rate=1r/s;
limit_conn_zone $binary_remote_addr zone=transfer_conn:10m;

server {
    listen 127.0.0.1:8080;
    server_name localhost;
    access_log off;

    location = /nginx-health {
        return 204;
    }
}

server {
    # 仅 IPv6 监听是有意为之:公网入口链路是 Cloudflare → 本机 IPv6
    # (见 AGENTS「IPv6 寻址」);容器接入 ipvlan 后端口映射失效,
    # IPv4 无入站监听(Xray Reality 443 已移除,宿主 IPv4 443 空置)。
    # 不要"修复"成双栈 listen——bridge/ipvlan 下 IPv4 发布需另建转发容器,
    # 当前架构无此需求。
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/certs/server_cert.pem;
    ssl_certificate_key /etc/nginx/certs/server_cert.key;

    # TLS hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    # 会话票据关闭 + 短超时:票据密钥长期不轮换会破坏 PFS(回放解密风险)。
    ssl_session_tickets off;
    ssl_session_timeout 4h;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Cloudflare Authenticated Origin Pulls (mTLS)
    ssl_client_certificate /etc/nginx/cloudflare-origin-pull.pem;
    ssl_verify_client on;

    # 封禁:blocked-ips.conf 由 admin ipBlocker 生成(map 定义 $workwork_blocked_cf /
    # $workwork_blocked_direct)。该文件是 nginx 启动的硬依赖(undefined variable
    # 即 emerg,并非空串降级),admin 在启动引导中同步生成它。放在 server 块
    # 使封禁覆盖全部 location(含 /proxy/query XHTTP 与媒体 API)。
    if ($workwork_blocked_cf) { return 403; }
    if ($workwork_blocked_direct) { return 403; }

    set $admin_upstream admin:__ADMIN_PORT__;
    set $proxy_forwarded_prefix "";

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-User $remote_user;
    proxy_set_header X-Forwarded-Prefix $proxy_forwarded_prefix;
    proxy_set_header X-Internal-Token "";
    proxy_set_header X-Fail2Ban-Token "";
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location = / {
        return 308 /admin/;
    }

    location = /admin {
        return 308 /admin/;
    }

    # 无鉴权存活探针(web-service-conventions):浅探针,nginx 门面可达即 200。
    # admin 深健康(运行时文件就绪)与版本指纹走 GET /api/admin/health(应用层
    # 免认证,但 nginx 层 /api/admin/ 有 basic auth,外部核对版本需带面板凭证),
    # 不在此处串联——探针语义单一,后端重启不该表现为整站探针失败。
    location = /healthz {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # media/music 已拆分至独立站 media.chaoset.com / music.chaoset.com
    # (web-service-conventions)。旧前缀的存量 App 连续性由 CF 边缘动态重定向
    # 承载(yinghuoren.com/api/media/* → media 新站 /api/*,music 同理,308;
    # 先加 CF 规则再部署本瘦身版,顺序见 subdomain-split-plan Phase 5),
    # 本机不再反代,旧路径落到下方 404 兜底。
    location /proxy/query {
        __XHTTP_PROXY_AUTH__
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        # 契约:此处必须 >= xray 服务端 scMaxEachPostBytes(xray.json.tmpl,
        # 当前 4MiB),否则合法分片先被 nginx 413、代理表现为"响应体停滞"。
        # Xray 客户端默认分片就是 1MiB,且会把多次 Write 合并成单个 POST
        # (dialer.go batching),packet-up 的 POST body 并非"远小于 MB 级"。
        # 16m 同时封住无限上传面。0(无上限)只省一次 413。
        client_max_body_size 16m;
        client_body_timeout 3600s;
        proxy_pass http://unix:/run/xray/xrxh.socket;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location /admin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        # 管理面限速:SPA 页面加载并发约 10 个请求,10r/s + burst 50(nodelay)
        # 对真人足够宽松;脚本化高频调用(含已认证滥用)被压到 429。
        limit_req zone=admin_api burst=50 nodelay;
        limit_req_status 429;
        proxy_pass http://$admin_upstream;
    }

    # Transfer public download — no authentication required.
    # 显式清空身份头：$remote_user 在客户端自带 Authorization 时即被 nginx 解析
    # （无需 auth_basic），server 级的 X-Forwarded-User $remote_user 会把它带给
    # admin——当前公开路由只用 code 无实害，但未来任何 /api/transfer 路由挂上
    # requireRole 即成越权。与 X-Internal-Token 的清空先例对齐。
    # 注意：location 内只要定义了任一 proxy_set_header，server 级的全部
    # proxy_set_header 都不再继承。因此这里必须完整重申 server 级头集合
    # （Host/X-Real-IP/X-Forwarded-For/Proto/Prefix + 两个内部 token 清空），
    # 否则此公开路由上 X-Real-IP 不被覆写——客户端可伪造限流键对任意 IP
    # 投毒 30 分钟全站封禁，X-Internal-Token 清空防线也同时失效。
    location /api/transfer/ {
        proxy_pass http://$admin_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix $proxy_forwarded_prefix;
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Internal-Token "";
        proxy_set_header X-Fail2Ban-Token "";
        # 公开无认证路由,是唯一可被匿名穷举的入口:1r/s + burst 5 压住
        # 分享码枚举,单 IP 并发下载连接数限 3。
        limit_req zone=transfer_dl burst=5 nodelay;
        limit_req_status 429;
        limit_conn transfer_conn 3;
        limit_conn_status 429;
        proxy_buffering off;
        proxy_read_timeout 600s;
        send_timeout 600s;
    }

    # 带宽/延迟测速 — 公开无认证（admin /speedtest/{size}），优选 CF 边缘 IP 的
    # 矩阵测试与用户自测入口。与 /api/transfer/ 同理：location 内必须完整重申
    # server 级头集合，否则 X-Real-IP 可被伪造对限流键投毒、内部 token 清空失效。
    # 复用 admin_api 限流（10r/s burst 50）压滥用；proxy_buffering off 让响应
    # 直通（缓冲 32MB 会占盘且让测速失真）。
    location /speedtest/ {
        proxy_pass http://$admin_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix $proxy_forwarded_prefix;
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Internal-Token "";
        proxy_set_header X-Fail2Ban-Token "";
        limit_req zone=admin_api burst=50 nodelay;
        limit_req_status 429;
        proxy_buffering off;
        proxy_read_timeout 600s;
        send_timeout 600s;
    }

    # Transfer upload — authenticated, large body (2GB)
    location = /api/admin/transfer/upload {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        limit_req zone=admin_api burst=50 nodelay;
        limit_req_status 429;
        proxy_pass http://$admin_upstream;
        # Go 端权威上限 = 2GB 文件 + 64MiB 余量(2112MiB,含 multipart 开销)。
        # 这里只须不小于它:写 2g 会让贴近上限的合法文件先被 nginx 413,
        # Go 端的截断检测永远够不到。2148m 留出实现余量。
        client_max_body_size 2148m;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
    }

    # 服务日志 SSE 长连接：/api/admin/ 继承的 300s 读超时会在日志静默时掐断流，
    # 单独放宽到 1 小时（前端断线有自动重连兜底）。
    # 注意：前缀不能以 / 结尾——nginx 会对不带尾斜杠的 /api/admin/services 自动
    # 301 补斜杠，而 admin 只注册了无斜杠路由，导致 Services/Logs 页 404。
    location /api/admin/services {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        # SSE 长连接只计请求建立瞬间,不受 10r/s 影响;burst 50 与管理面一致。
        limit_req zone=admin_api burst=50 nodelay;
        limit_req_status 429;
        proxy_pass http://$admin_upstream;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/admin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        limit_req zone=admin_api burst=50 nodelay;
        limit_req_status 429;
        proxy_pass http://$admin_upstream;
    }

    # Static assets with fingerprint hashes — cache forever
    location ~ ^/(?:assets/|favicon\.svg$|icons\.svg$) {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        # fail2ban 的 nginx-auth filter 只 tail admin-access.log;此处必须写同一
        # 日志文件,401 才能被计数(否则 filter 里的 assets/favicon 分支永不匹配)。
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        proxy_pass http://$admin_upstream;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        # add_header in a location block does NOT inherit server-level add_header
        # directives in nginx; security headers must be repeated here.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    }

    # 兜底:未匹配路径显式 404,避免落到镜像默认静态根(/index.html、/50x.html)
    # 暴露 nginx:alpine 默认页面。
    location / {
        return 404;
    }
}
