log_format auth_log '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'upstream: $upstream_addr';

include /etc/nginx/cloudflare-ips.conf;

server_tokens off;

tcp_nodelay on;

resolver 127.0.0.11 valid=30s;

server {
    listen 127.0.0.1:8080;
    server_name localhost;
    access_log off;

    location = /nginx-health {
        return 204;
    }
}

server {
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/certs/server_cert.pem;
    ssl_certificate_key /etc/nginx/certs/server_cert.key;

    # TLS hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Cloudflare Authenticated Origin Pulls (mTLS)
    ssl_client_certificate /etc/nginx/cloudflare-origin-pull.pem;
    ssl_verify_client on;

    # 封禁:blocked-ips.conf 由 admin ipBlocker 生成(map 定义 $workwork_blocked_cf /
    # $workwork_blocked_direct)。变量未定义(无封禁配置)时为空串,if 不成立,
    # 不影响正常请求。放在 server 块使封禁覆盖全部 location(含 /proxy/query
    # XHTTP 与媒体 API),而不再只作用于 admin 应用层。
    if ($workwork_blocked_cf) { return 403; }
    if ($workwork_blocked_direct) { return 403; }

    set $admin_upstream admin:__ADMIN_PORT__;
    set $media_upstream __MEDIA_CENTER_UPSTREAM__;
    set $web_search_upstream web-search-mcp:8320;
    set $proxy_forwarded_prefix "";

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-User $remote_user;
    proxy_set_header X-Forwarded-Prefix $proxy_forwarded_prefix;
    proxy_set_header X-Internal-Token "";
    proxy_set_header X-Fail2Ban-Token "";
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location = / {
        return 308 /admin/;
    }

    location = /admin {
        return 308 /admin/;
    }

    location = __MEDIA_CENTER_PUBLIC_PATH__ {
        # media_server 是纯目录服务,路由只有 /api/providers、/api/providers/{p}/categories
        # 等——没有 /api/categories,原重定向落地即 404。指向真实存在的入口。
        return 308 __MEDIA_CENTER_PUBLIC_PATH__/providers;
    }

    location __MEDIA_CENTER_PUBLIC_PATH__/ {
        set $proxy_forwarded_prefix __MEDIA_CENTER_PUBLIC_PATH__;
        rewrite ^__MEDIA_CENTER_PUBLIC_PATH_REGEX__(/.*)$ /api$1 break;
        proxy_pass http://$media_upstream;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Web Search MCP — SSE 长连接(客户端经此接收 JSON-RPC 响应)
    location = __WEB_SEARCH_PUBLIC_PATH__/sse {
        proxy_pass http://$web_search_upstream/sse;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # SSE 必须关闭缓冲
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Web Search MCP — 客户端 POST JSON-RPC 请求
    location __WEB_SEARCH_PUBLIC_PATH__/message {
        proxy_pass http://$web_search_upstream/message;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /proxy/query {
        __XHTTP_PROXY_AUTH__
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        client_max_body_size 0;
        client_body_timeout 3600s;
        proxy_pass http://unix:/run/xray/xrxh.socket;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location /admin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        proxy_pass http://$admin_upstream;
    }

    # Binary/NDJSON downloads stream for both Claude Code and Xray.
    location ~ ^/api/admin/(?:claude-code|xray)/(?:download$|downloads/) {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        proxy_pass http://$admin_upstream;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        send_timeout 600s;
    }

    # Transfer public download — no authentication required
    location /api/transfer/ {
        proxy_pass http://$admin_upstream;
        proxy_buffering off;
        proxy_read_timeout 600s;
        send_timeout 600s;
    }

    # Transfer upload — authenticated, large body (2GB)
    location = /api/admin/transfer/upload {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        proxy_pass http://$admin_upstream;
        client_max_body_size 2g;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
    }

    location /api/admin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        proxy_pass http://$admin_upstream;
    }

    # Static assets with fingerprint hashes — cache forever
    location ~ ^/(?:assets/|favicon\.svg$|icons\.svg$) {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        # fail2ban 的 nginx-auth filter 只 tail admin-access.log;此处必须写同一
        # 日志文件,401 才能被计数(否则 filter 里的 assets/favicon 分支永不匹配)。
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        proxy_pass http://$admin_upstream;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        # add_header in a location block does NOT inherit server-level add_header
        # directives in nginx; security headers must be repeated here.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    }
}
