log_format auth_log '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'upstream: $upstream_addr';

include /etc/nginx/cloudflare-ips.conf;

server_tokens off;

tcp_nodelay on;

resolver 127.0.0.11 valid=30s;

server {
    listen 127.0.0.1:8080;
    server_name localhost;
    access_log off;

    location = /nginx-health {
        return 204;
    }
}

server {
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/certs/server_cert.pem;
    ssl_certificate_key /etc/nginx/certs/server_cert.key;

    # TLS hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Cloudflare Authenticated Origin Pulls (mTLS)
    ssl_client_certificate /etc/nginx/cloudflare-origin-pull.pem;
    ssl_verify_client on;

    set $admin_upstream admin:__ADMIN_PORT__;
    set $media_upstream __MEDIA_CENTER_UPSTREAM__;
    set $proxy_forwarded_prefix "";

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-User $remote_user;
    proxy_set_header X-Forwarded-Prefix $proxy_forwarded_prefix;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location = / {
        return 308 /admin/;
    }

    location = /admin {
        return 308 /admin/;
    }

    location = __MEDIA_CENTER_PUBLIC_PATH__ {
        return 308 __MEDIA_CENTER_PUBLIC_PATH__/categories;
    }

    location = __MEDIA_CENTER_PUBLIC_PATH__/asset {
        set $proxy_forwarded_prefix __MEDIA_CENTER_PUBLIC_PATH__;
        rewrite ^__MEDIA_CENTER_PUBLIC_PATH_REGEX__(/.*)$ /api$1 break;
        proxy_pass http://$media_upstream;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location __MEDIA_CENTER_PUBLIC_PATH__/ {
        set $proxy_forwarded_prefix __MEDIA_CENTER_PUBLIC_PATH__;
        rewrite ^__MEDIA_CENTER_PUBLIC_PATH_REGEX__(/.*)$ /api$1 break;
        proxy_pass http://$media_upstream;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location /proxy/query {
        __XHTTP_PROXY_AUTH__
        access_log /dev/stdout auth_log;
        client_max_body_size 0;
        client_body_timeout 3600s;
        proxy_pass http://unix:/dev/shm/xrxh.socket;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location /admin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        proxy_pass http://$admin_upstream;
    }

    # Binary/NDJSON downloads stream for both Claude Code and Xray.
    location ~ ^/api/admin/(?:claude-code|xray)/(?:download$|downloads/) {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        proxy_pass http://$admin_upstream;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        send_timeout 600s;
    }

    # Transfer public download — no authentication required
    location /api/transfer/ {
        proxy_pass http://$admin_upstream;
        proxy_buffering off;
        proxy_read_timeout 600s;
        send_timeout 600s;
    }

    # Transfer upload — authenticated, large body (2GB)
    location = /api/admin/transfer/upload {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        proxy_pass http://$admin_upstream;
        client_max_body_size 2g;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
    }

    location /api/admin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        access_log /dev/stdout auth_log;
        proxy_pass http://$admin_upstream;
    }

    # Static assets with fingerprint hashes — cache forever
    location ~ ^/(?:assets/|favicon\.svg$|icons\.svg$) {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        proxy_pass http://$admin_upstream;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
}
