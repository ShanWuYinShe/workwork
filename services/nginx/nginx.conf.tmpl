log_format auth_log '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'upstream: $upstream_addr';

include /etc/nginx/cloudflare-ips.conf;

server_tokens off;

resolver 127.0.0.11 valid=10s;

server {
    listen [__NGINX_IPV6__]:443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/certs/server_cert.pem;
    ssl_certificate_key /etc/nginx/certs/server_cert.key;

    # TLS hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Cloudflare Authenticated Origin Pulls (mTLS)
    ssl_client_certificate /etc/nginx/cloudflare-origin-pull.pem;
    ssl_verify_client on;

    location /proxy/query {
        auth_basic off;
        access_log /var/log/nginx/proxy-query-access.log auth_log;
        client_max_body_size 0;
        grpc_read_timeout 300s;
        grpc_send_timeout 300s;
        grpc_set_header X-Real-IP $remote_addr;
        grpc_pass unix:/dev/shm/xrxh.socket;
    }

    location /admin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-User $remote_user;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Large file downloads: buffered with early flush to avoid serial read-write cycles.
    # Default proxy_busy_buffers_size (8KB) forces ~19000 send-wait rounds for a 150MB file.
    location /api/admin/claude-code/downloads/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-User $remote_user;
        proxy_buffering on;
        proxy_buffers 16 256k;
        proxy_buffer_size 256k;
        proxy_busy_buffers_size 512k;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        send_timeout 600s;
    }

    location /api/admin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-User $remote_user;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Static assets with fingerprint hashes — cache forever
    location /assets/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /favicon.svg {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /icons.svg {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~ ^/api/cliproxy/user/([a-f0-9]+)(/.*)?$ {
        set $cp_user $1;
        set $cp_path $2;
        if ($cp_path = '') {
            set $cp_path /;
        }
        proxy_pass http://cliproxy-$cp_user:8317$cp_path$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-User $remote_user;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
