log_format auth_log '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'upstream: $upstream_addr';

set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

resolver 127.0.0.11 valid=10s;

server {
    listen [__NGINX_IPV6__]:80;
    server_name _;

    location / {
        return 404;
    }

    location /proxy/query {
        auth_basic off;
        access_log /var/log/nginx/proxy-query-access.log auth_log;
        set $xray_upstream http://xray:8447;
        proxy_pass $xray_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /admin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-User $remote_user;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /api/admin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        access_log /var/log/nginx/admin-access.log auth_log;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-User $remote_user;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /assets/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /favicon.svg {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /icons.svg {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;
        proxy_pass http://admin:__ADMIN_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /api/cliproxy/ {
        proxy_pass http://cliproxy-public:8317/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-User $remote_user;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

}

