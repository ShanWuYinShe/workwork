[DEFAULT]
ignoreself = true
ignoreip = 127.0.0.1/8 ::1

# 只保留一个 nginx-auth jail（原 nginx-secure-auth / admin-manual 已合并）：
# 三个 jail 监听同一日志、同一 filter、调用同一 admin block API，导致
# 同一批 401 被各自计数、封禁时长（3600/7200/86400s）不可预期，且任一
# jail 的 unban（bantime 到期）会解除 admin 侧的整条封禁，另两个 jail
# 的剩余封禁期被提前终止——防御时长被削弱。合并为一档后行为可预期。
[nginx-auth]
enabled = true
filter = nginx-auth
logpath = /var/log/nginx/admin-access.log
action = admin-api
bantime = 3600
findtime = 300
# 在线撞库预算:10 次/5min × 多 IP 仍有撞库空间,panel basic auth 有 bcrypt
# 兜底离线暴力。不能用更小的值:浏览器冷启动(重启后首次打开面板)时,
# 文档请求 401 质询期间并发的子资源/接口请求会不带凭证各吃一次 401
# (实测一次冷启动产生 6 条),maxretry=5 会把正常用户误封 1 小时
# (已实际发生多次);登出功能的凭证覆盖请求也产生 1 条 401。
maxretry = 10
# 递进封禁:重复违规者时长 ×1,2,4,8,16,32 递增(封禁时长经 admin-api action
# 的 <bantime> 占位符自动流入 block API,admin 侧 10 年上限内)。记忆依赖
# fail2ban 持久库(已纳入 backup.sh),重启不清零;此前撞库者每 3600s 释放后
# 可无限循环。maxtime 封顶两周,rndtime 加随机防僵尸网络掐点解封后重试。
bantime.increment = true
bantime.maxtime = 2w
bantime.rndtime = 10m

[sshd]
enabled = false

[sshd-ddos]
enabled = false
