[DEFAULT]
ignoreself = true
ignoreip = 127.0.0.1/8 ::1

[nginx-auth]
enabled = true
filter = nginx-auth
logpath = /var/log/nginx/admin-access.log
action = admin-api
bantime = 3600
findtime = 300
maxretry = 8

[nginx-secure-auth]
enabled = true
filter = nginx-auth
logpath = /var/log/nginx/admin-access.log
action = admin-api
bantime = 7200
findtime = 600
maxretry = 15

[admin-manual]
enabled = true
filter = nginx-auth
logpath = /var/log/nginx/admin-access.log
action = admin-api
bantime = 86400
findtime = 60
maxretry = 100

[sshd]
enabled = false

[sshd-ddos]
enabled = false