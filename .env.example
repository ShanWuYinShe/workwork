# ===========================================
# Service Configuration
# ===========================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# This repository's .env is gitignored and bind-mounted into the admin
# container as /app/.env. Put first-start secrets such as AUTH_PASS and
# XRAY_PRIVATE_KEY here, then restrict file permissions on the host.

# --- Compose ---
# Must match the Docker Compose project that admin manages through docker.sock.
COMPOSE_PROJECT_NAME=workwork

# --- Network ---
# IPv6 addresses for external-facing services (within Docker ipvlan subnet)
NGINX_IPV6=2001:db8:2623:1::10
XRAY_IPV6=2001:db8:2623:1::12

# --- Xray VLESS ---
# Comma-separated client UUIDs
XRAY_CLIENT_IDS=uuid1,uuid2
# Reality short IDs (comma-separated, 8 位 hex 2-3 条更接近真实流量特征)
XRAY_SHORT_IDS=abcdef
# X25519 private key (REQUIRED at first start: renders the Reality inbound in
# xray.json.tmpl; missing/empty = xray inbound won't come up). Generate a pair
# with: xray x25519   → private key goes here, public key to XRAY_PUBLIC_KEY.
XRAY_PRIVATE_KEY=
# X25519 public key (derived from private key: xray x25519 -i <private>)
XRAY_PUBLIC_KEY=your_x25519_public_key_here
# Domain for xhttp fallback
XHTTP_DOMAIN=your-domain.com
# Reality destination for camouflage
# 注意：勿用 www.microsoft.com 等大厂热门域名——2026-09 实测该组合会被
# GFW 针对性破坏（握手认证数据被改写、数据流限速至 ~1Mbps），推荐
# addons.mozilla.org 这类冷门且支持 TLS1.3/H2 的站点。
XRAY_REALITY_DEST=addons.mozilla.org:443
XRAY_REALITY_SERVER_NAME=addons.mozilla.org

# --- Nginx Basic Auth ---
AUTH_USER=admin
# AUTH_PASS should be supplied at first startup if no existing htpasswd exists.
AUTH_PASS=change_me_before_first_start
# Optional scoped token used only by nginx fail2ban to block/unblock IPs.
# Leave blank to let admin generate and persist one in .wework/fail2ban/token.
FAIL2BAN_TOKEN=

# --- IPv6 Network ---
# IPv6 subnet for address allocation. Must match the /64 used by setup-networks.sh
# (and the ipvlan_docker network). The 5th hextet `1` defines the static range,
# `f` defines the rotating range. Replace with your real assigned /64;
# default shown is a documentation-only prefix (RFC 3849). Must match setup-networks.sh.
IPV6_SUBNET=2001:db8:2623::/64
# Subdomain for Reality IPv6 tracking (DNS-only, NOT full proxy)
XRAY_REALITY_DOMAIN=reality.example.com
# Additional comma-separated domains assigned to nginx for Cloudflare DNS sync
# (optional). XHTTP_DOMAIN and XRAY_REALITY_DOMAIN are always included.
NGINX_DOMAINS=

# --- Cloudflare (optional) ---
# API token for Cloudflare DNS management in the admin Settings page
# (Zone:DNS:Edit permission). Leave blank to disable DNS sync features.
CF_API_TOKEN=

# --- Admin Panel ---
# 注意：改这个值会静默破坏两处硬编码依赖——admin 容器 healthcheck
# (wget localhost:8318/...) 与 fail2ban 封禁 action (http://admin:8318/...)，
# 按需同步修改 docker-compose.yml 与 services/nginx/config/fail2ban/action.d/admin-api.conf。
ADMIN_PORT=8318
# Reverse proxies allowed to set X-Forwarded-User. Default runtime behavior is
# loopback CIDRs plus the Compose nginx service hostname.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
TRUSTED_PROXY_HOSTS=nginx
# Optional path-prefix whitelist for the internal automation token (X-Internal-Token),
# comma-separated. When set, the token only bypasses auth under these prefixes and
# any other path falls back to normal authentication; rejected attempts are logged
# with [security]. Leave BLANK to keep the token's full-access behavior (backward
# compatible). Recommended once you know which prefixes your automation needs,
# e.g. INTERNAL_TOKEN_ALLOWED_PREFIXES=/api/admin/security,/api/admin/dashboard
# (INTERNAL_TOKEN itself is auto-generated at first start into .wework/.internal-token)
INTERNAL_TOKEN_ALLOWED_PREFIXES=

# --- Event notifications ---
# Optional webhook URL for key events (Security IP block/unblock, rate-limit auto
# ban, xhttp self-heal reaching its hourly restart cap, deploy verification failure).
# admin POSTs a flat JSON envelope {event, summary, details, time} asynchronously;
# delivery failures are logged, never fatal. Works with Telegram bot / WeCom bot /
# any self-hosted receiver that just logs or relays.
WEBHOOK_URL=

# --- Media Center ---
# Internal upstream used by nginx. Default points to the Compose service.
MEDIA_CENTER_UPSTREAM=media_server:8787
# Public API prefix exposed by nginx. Android app can use https://your-domain.com/api/media.
MEDIA_CENTER_PUBLIC_PATH=/api/media
# --- Media Center catalog management ---
# Shared token gating media_server's internal management API (/internal/*). admin uses the
# same token to proxy catalog overview / items / review / delete / import / export.
# Leave BLANK to fully disable the management API (the /internal/* tree then returns 404).
# Set a long random value to enable, e.g. generate with: openssl rand -hex 32
MEDIA_SERVER_INTERNAL_TOKEN=
# Where admin reaches the media_server internal API (internal_docker only). Default is fine.
MEDIA_CENTER_INTERNAL_URL=http://media_server:8787
# Public base URL for App update downloads. FIXED here so the server never derives the
# download URL from the request Host header (Host header poisoning → malicious APK).
MEDIA_SERVER_PUBLIC_URL=https://yinghuoren.com/api/media
# Token gating /api/providers/credentials (shared-account session cookies like SESSDATA).
# Must match the APP_API_TOKEN gradle property used when building the App. Leave BLANK to
# disable the credentials endpoint (App falls back to free 1080P).
MEDIA_SERVER_APP_API_TOKEN=
# Optional override for the vod_extractor base URL media_server uses for Media
# Center YouTube search+resolve (defaults to http://vod_extractor:8790 inside the
# compose network). No API key needed: search goes through yt-dlp (no Data API quota).
#MEDIA_SERVER_VOD_EXTRACTOR_URL=http://vod_extractor:8790

# --- File transfer station ---
# Per-user upload quota in bytes (0 = unlimited, default 5GB). Prevents one user
# filling the global 20GB pool with repeated 2GB uploads.
TRANSFER_USER_QUOTA=5368709120

# --- Music server (netease upstream) ---
# Optional: NetEase Cloud Music account cookie (e.g. "MUSIC_U=...") passed to the
# netease_api upstream to unlock account-tier songs. Anonymous access can only
# stream free tracks. Leave empty for anonymous mode.
NETEASE_MUSIC_COOKIE=
# Token gating music_server's app API. Leave BLANK to keep the API open to any
# internet user through Cloudflare (it then consumes the real account cookie
# above anonymously — risk of triggering NetEase risk control on the account).
# Set a long random value, e.g. generate with: openssl rand -hex 32
MUSIC_SERVER_APP_API_TOKEN=
# Optional override for the netease_api base URL admin uses for QR login/status
# (defaults to http://netease_api:3000 inside the compose network).
#NETEASE_API_BASE=http://netease_api:3000

# --- vod_extractor (YouTube resolve) ---
# 调优项,默认值见 docker-compose.yml;宿主机必须提供真实 cookies:
# .wework/vod_extractor/youtube-cookies.txt(硬前提,见 README 部署流程)。
#VOD_EXTRACTOR_TIMEOUT_MS=30000
#VOD_EXTRACTOR_MAX_OUTPUT_BYTES=20971520
#VOD_EXTRACTOR_MAX_CONCURRENT=2
#VOD_EXTRACTOR_EXTRACTOR_ARGS=
#VOD_EXTRACTOR_COOKIES_FILE=

# --- Docker ---
# Docker socket group ID on the host (admin container needs this to access docker.sock)
# Find with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=988

# --- Docker 基础镜像版本（跨项目统一）---
# 生效位置（随 git 发布，服务器 git pull 即生效，无需拷贝 .env）：
#   docker-compose.yml 中的 ${VAR:-默认值}，以及各 Dockerfile（含
#   services/media_center 与 services/music_player 子模块）的 ARG 默认值——
#   两处默认值保持一致。
# 本段仅为升级对照表；不要往实际 .env 里填这些变量（.env 不入库，
# 服务器收不到，会造成本地与服务器双源漂移）。.env 覆盖仅用于临时验证。
# 全局统一值：Go 1.26.5 / Alpine 3.24.1 / Bun 1.3.14 / Nginx 1.30.4，
# 与 hotspot、ops-portal 对齐。
# 升级任一基础镜像时：改 compose/Dockerfile 中的默认值 + 同步其他仓库，保持矩阵一致。
# （子模块 Dockerfile 的默认值在子模块仓库内同步修改。）
BUN_VERSION=1.3.14
GO_VERSION=1.26.5
ALPINE_VERSION=3.24.1
NGINX_VERSION=1.30.4
