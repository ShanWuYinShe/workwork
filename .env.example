# ===========================================
# Service Configuration
# ===========================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Sensitive values should be passed at runtime, NOT stored in .env:
#   XRAY_PRIVATE_KEY=xxx AUTH_PASS=yyy CF_API_TOKEN=zzz bash deploy.sh
#   XRAY_PRIVATE_KEY=xxx AUTH_PASS=yyy CF_API_TOKEN=zzz docker compose up -d

# --- Network ---
# IPv6 addresses for external-facing services (within Docker ipvlan subnet)
NGINX_IPV6=2605:a141:2322:2623:1::10
XRAY_IPV6=2605:a141:2322:2623:1::12

# --- Xray VLESS ---
# Comma-separated client UUIDs
XRAY_CLIENT_IDS=uuid1,uuid2
# Reality short IDs (comma-separated)
XRAY_SHORT_IDS=abcdef
# X25519 public key (derived from private key: xray x25519 -i <private>)
XRAY_PUBLIC_KEY=your_x25519_public_key_here
# Domain for xhttp fallback
XHTTP_DOMAIN=your-domain.com
# Reality destination for camouflage
XRAY_REALITY_DEST=www.microsoft.com:443
XRAY_REALITY_SERVER_NAME=www.microsoft.com

# --- Nginx Basic Auth ---
AUTH_USER=admin
# AUTH_PASS should be supplied at first startup if no existing htpasswd exists.
# Keep it out of committed files; pass it via the shell or deployment secret.

# --- IPv6 Network ---
# IPv6 subnet for address allocation. Must match the /64 used by setup-networks.sh
# (and the ipvlan_docker network). The 5th hextet `1` defines the static range,
# `f` defines the rotating range. Use `2623::/64` to match setup-networks.sh default.
IPV6_SUBNET=2605:a141:2322:2623::/64
# Subdomain for Reality IPv6 tracking (DNS-only, NOT full proxy)
XRAY_REALITY_DOMAIN=reality.example.com

# --- Admin Panel ---
ADMIN_PORT=8318
# Reverse proxies allowed to set X-Forwarded-User. Default runtime behavior is
# loopback CIDRs plus the Compose nginx service hostname.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
TRUSTED_PROXY_HOSTS=nginx

# --- Media Center ---
# Internal upstream used by nginx. Default points to the Compose service.
MEDIA_CENTER_UPSTREAM=media_server:8787
# Public API prefix exposed by nginx. Android app can use https://your-domain.com/api/media.
MEDIA_CENTER_PUBLIC_PATH=/api/media
# Optional stable signing key for opaque media/video IDs. Leave blank to generate per process.
MEDIA_SERVER_SIGNING_KEY=
# Backward-compatible fallback for older deployments still reading the legacy name.
MEDIA_ASSET_SIGNING_KEY=
# Upstream bilibili API timeout for metadata + playurl requests.
MEDIA_SERVER_PROVIDER_FETCH_TIMEOUT_MS=15000
# Maximum provider pages fetched per category request.
MEDIA_SERVER_CATEGORY_MAX_PAGES=6
# Proxy asset cache settings for media_server.
MEDIA_ASSET_CACHE_MAX_BYTES=53687091200
# Optional YouTube Data API key. Required only when enabling the youtube source.
YOUTUBE_API_KEY=
# Internal VOD extractor endpoint. Compose sets this automatically for media_server.
VOD_EXTRACTOR_URL=http://vod_extractor:8790/extract

# --- Docker ---
# Docker socket group ID on the host (admin container needs this to access docker.sock)
# Find with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=988
