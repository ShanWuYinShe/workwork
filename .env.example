# ===========================================
# Service Configuration
# ===========================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# --- Network ---
# IPv6 addresses for external-facing services (within Docker ipvlan subnet)
NGINX_IPV6=2605:a141:2322:2623:1::10
XRAY_IPV6=2605:a141:2322:2623:1::12

# --- Xray VLESS ---
# Comma-separated client UUIDs
XRAY_CLIENT_IDS=uuid1,uuid2
# X25519 private key (generate: xray x25519)
XRAY_PRIVATE_KEY=your_x25519_private_key_here
# Reality short IDs (comma-separated)
XRAY_SHORT_IDS=abcdef
# Reality destination for camouflage
XRAY_REALITY_DEST=www.microsoft.com:443
XRAY_REALITY_SERVER_NAME=www.microsoft.com

# --- CliproxyAPI ---
# Comma-separated API keys
CLIPROXY_API_KEYS=your-api-key-here

# --- Nginx Basic Auth ---
# Username and password for /secure/ routes
AUTH_USER=admin
AUTH_PASS=your-password-here

# --- Admin Panel ---
CF_TEAM_DOMAIN=https://<team-name>.cloudflareaccess.com
CF_POLICY_AUD=<aud-tag-from-access-app>
ADMIN_PORT=8318
