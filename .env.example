# ===========================================
# Service Configuration
# ===========================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Sensitive values should be passed at runtime, NOT stored in .env:
#   XRAY_PRIVATE_KEY=xxx AUTH_PASS=yyy CF_API_TOKEN=zzz bash deploy.sh
#   XRAY_PRIVATE_KEY=xxx AUTH_PASS=yyy CF_API_TOKEN=zzz docker compose up -d

# --- Network ---
# IPv6 addresses for external-facing services (within Docker ipvlan subnet)
NGINX_IPV6=2605:a141:2322:2623:1::10
XRAY_IPV6=2605:a141:2322:2623:1::12

# --- Xray VLESS ---
# Comma-separated client UUIDs
XRAY_CLIENT_IDS=uuid1,uuid2
# Reality short IDs (comma-separated)
XRAY_SHORT_IDS=abcdef
# X25519 public key (derived from private key: xray x25519 -i <private>)
XRAY_PUBLIC_KEY=your_x25519_public_key_here
# Domain for xhttp fallback
XHTTP_DOMAIN=your-domain.com
# Reality destination for camouflage
XRAY_REALITY_DEST=www.microsoft.com:443
XRAY_REALITY_SERVER_NAME=www.microsoft.com

# --- Nginx Basic Auth ---
AUTH_USER=admin

# --- IPv6 Network ---
# IPv6 subnet for address allocation
IPV6_SUBNET=2605:a141:2322:2623:1::/64
# Subdomain for Reality IPv6 tracking (DNS-only, NOT full proxy)
XRAY_REALITY_DOMAIN=reality.example.com

# --- Admin Panel ---
ADMIN_PORT=8318
