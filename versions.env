# workwork 编排栈基础镜像版本唯一事实来源。
# media/music 已拆分至独立站(各站版本见其仓库 deploy/versions.env),本文件
# 仅覆盖本仓四个服务:admin / docker-proxy / xray / nginx。
# 升级:改这里 → make build → make up <svc...>;make check 会校验本文件与
# compose 的 :- 兜底、各 Dockerfile ARG、CI 的 go/bun-version、.env.example
# 对照值全部一致（scripts/sync-versions.sh check）。
GO_VERSION=1.26.11
ALPINE_VERSION=3.24.1
BUN_VERSION=1.3.14
NGINX_VERSION=1.30.4
XRAY_VERSION=26.6.27
