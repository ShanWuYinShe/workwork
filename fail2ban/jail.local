[nginx-secure-auth]
enabled   = true
filter    = nginx-auth
logpath   = /Users/liyou/Work/service/logs/nginx/proxy-query-access.log
           /Users/liyou/Work/service/logs/nginx/proxy-ws-access.log
           /Users/liyou/Work/service/logs/nginx/workwork-access.log
action    = iptables-local[name=nginx-secure-auth]
bantime   = 3600
findtime  = 600
maxretry  = 5